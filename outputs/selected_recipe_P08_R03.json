{
  "recipe_id": "P08_R03",
  "recipe_data": {
    "participant": "P08",
    "name": "Scrambled Eggs",
    "type": "online",
    "source": "https://www.loveandlemons.com/scrambled-eggs-recipe/",
    "steps": {
      "P08_R03_S01": "Crack the eggs into a medium bowl. Whisk until smooth and combined, with no streaks of egg white remaining.",
      "P08_R03_S02": "Spray olive oil in a small nonstick skillet. Bring to medium heat.",
      "P08_R03_S03": "Add chopped red onions and finger chillies to a pan and saute until soft",
      "P08_R03_S04": "Pour in the eggs, and let them cook for a few seconds without stirring. Pull a rubber spatula across the bottom of the pan to form large, soft curds of scrambled eggs.",
      "P08_R03_S05": "Continue cooking over medium-low heat, folding and stirring the eggs every few seconds. Scrape the spatula along the bottom and sides of the pan often to form more curds and to prevent any part of the eggs from drying out",
      "P08_R03_S06": "Remove the pan from the heat when the eggs are mostly set, but a little liquid egg remains. Season to taste with salt and pepper.",
      "P08_R03_S07": "Add cottage cheese to plate and season to taste with salt, pepper, oregano and olive oil."
    },
