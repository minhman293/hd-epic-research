{
  "recipe_id": "P09_R04",
  "recipe_data": {
    "participant": "P09",
    "name": "Mangsho Bhuna",
    "type": "modified",
    "source": "https://experiencesofagastronomad.com/hansher-mangsho-bhuna/",
    "steps": {
      "P09_R04_S01": "Heat oil in a pan and throw in some cinnamon sticks, cardamon, cloves, black peppercorn.",
      "P09_R04_S02": "Add half of the sliced onion and fry until the onion begin to brown. Set aside the other half for later use.",
      "P09_R04_S03": "Add water to the mix along with turmeric and red chili powder and stir.",
      "P09_R04_S04": "Then add in the garlic and ginger paste, ghee, yoghurt and stir.",
      "P09_R04_S05": "Now add the meat to the mix and stir to mix evenly.",
      "P09_R04_S06": "Cover and cook until the meat is cooked through and a bit tender (50 - 55mins), occasionally adding water and stirring to prevent burning and sticking to the pan",
      "P09_R04_S07": "Fry the second half of the onions until browned. Once cooked, add to the rest of the mixture.",
      "P09_R04_S08": "Once the meat is cooked and tender, add the fried onion, cumin, garam masala, ghee and chili and cook through until the meat is tender."
    },
