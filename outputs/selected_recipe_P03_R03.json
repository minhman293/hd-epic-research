{
  "recipe_id": "P03_R03",
  "recipe_data": {
    "participant": "P03",
    "name": "Drip Coffee",
    "type": "own",
    "source": "https://www.hario.co.uk/pages/brew-guides-v60-basic",
    "steps": {
      "P03_R03_S01": "Boil water using kettle",
      "P03_R03_S02": "Grind coffee beans using the electric coffee grinder",
      "P03_R03_S03": "Pour ground coffee into the metal V60 filter",
      "P03_R03_S04": "Pour water into the V60. Pour enough hot water to soak all the coffee grounds, then wait until most water is filtered through.",
      "P03_R03_S05": "Slowly pour over the remaining water over the coffee, making small circles. Stop when the water is 3/4 of the way or 2 cm from the top.",
      "P03_R03_S06": "Wait for it to drain, allowing the coffee to cool down a little."
    },
